// QuietChat 应用目标的共享构建设置。
// 签名默认使用本机临时签名（Sign to Run Locally），任何人拉下代码都能直接编译运行。
// 临时签名每次编译都会变，系统会因此让「辅助功能」授权失效；
// 想固定签名身份时，把 Local.xcconfig.example 复制为 Local.xcconfig 并填写（该文件不提交）。

#include "../../Version.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = io.github.OumCc.QuietChat
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

INFOPLIST_FILE = Configs/QuietChat-Info.plist
CODE_SIGN_ENTITLEMENTS = Configs/QuietChat.entitlements
// 空变量避免 xcconfig 把 URL 中的双斜线当作注释；测试构建可覆盖更新源和公钥。
SPARKLE_FEED_URL = https:/$()/github.com/OumCc/quiet-chat/releases/latest/download/appcast.xml
SPARKLE_PUBLIC_ED_KEY = P4MIh0y6O5GAEBr2wlyI/il8zIcdPecaxi0bcNJINys=

#include? "Local.xcconfig"
